msgid "Good news! ${object.product_id.name or 'Product'} is now available"
msgstr "Гарні новини! ${object.product_id.name or 'Товар'} тепер у наявності"

#. module: crm_product_mailing
#: model:mail.template,body_html:crm_product_mailing.mail_template_high_stock
msgid "Hello"
msgstr "Вітаємо"

#. module: crm_product_mailing
#: model:mail.template,body_html:crm_product_mailing.mail_template_high_stock
msgid "Great news! The product you were interested in is now available in stock:"
msgstr "Чудові новини! Товар, який вас цікавив, тепер є у наявності:"

#. module: crm_product_mailing
#: model:mail.template,body_html:crm_product_mailing.mail_template_high_stock
msgid "We have plenty of stock available, so don't miss this opportunity!"
msgstr "У нас достатньо товару на складі, тож не пропустіть цю можливість!"

#. module: crm_product_mailing
#: model:mail.template,body_html:crm_product_mailing.mail_template_high_stock
msgid "Please contact us to place your order or get more information."
msgstr "Будь ласка, зв'яжіться з нами для оформлення замовлення або отримання додаткової інформації."

#. module: crm_product_mailing
#: model:mail.template,body_html:crm_product_mailing.mail_template_high_stock
#: model:mail.template,body_html:crm_product_mailing.mail_template_low_stock
