<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

        <!-- 
            CRON 1: Reset Product Mailing Triggers
            Purpose: Runs FIRST each day to reset daily flags
            Schedule: Daily at 00:00 (priority 5 - runs before generation)
            Logic: Resets mailing_triggered_today flag on ALL products
                   This allows products to be processed again the next day
        -->
        <record id="ir_cron_reset_mailing_triggers" model="ir.cron">
            <field name="name">Reset Product Mailing Triggers</field>
            <field name="model_id" ref="product.model_product_product"/>
            <field name="state">code</field>
            <field name="code">model.reset_mailing_trigger()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
            <field name="priority">5</field>
        </record>

        <!-- 
            CRON 2: Generate Product Availability Mailings
            Purpose: Runs SECOND each day to create draft mailings
            Schedule: Daily at 01:00 (priority 10 - runs after reset)
            Logic: 
                1. Find products with qty_available > 0 and not triggered today
                2. For each product:
                   - High stock (>= threshold): Email ALL leads with this product
                   - Low stock (< threshold): Email RECENT leads with this product (last N days)
                3. Create draft mailing.mailing for manual review
                4. Mark product as triggered today (prevent duplicates)
        -->
        <record id="ir_cron_generate_product_mailings" model="ir.cron">
            <field name="name">Generate Product Availability Mailings</field>
            <field name="model_id" ref="product.model_product_product"/>
            <field name="state">code</field>
            <field name="code">model.generate_daily_mailings()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
            <field name="priority">10</field>
        </record>

</odoo>
